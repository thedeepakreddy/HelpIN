{
  "name": "@helpin/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start": "tsx src/server.ts",
    "start:worker": "tsx src/worker.ts",
    "migrate": "tsx --env-file-if-exists=.env ../../packages/db/src/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "db:reset": "tsx --env-file-if-exists=.env ../../packages/db/src/reset.ts",
    "check:providers": "tsx --env-file-if-exists=.env src/scripts/check-providers.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.5",
    "@helpin/config": "workspace:*",
    "@helpin/contracts": "workspace:*",
    "@helpin/db": "workspace:*",
    "@helpin/domain": "workspace:*",
    "@helpin/geo": "workspace:*",
    "fastify": "^5.12.5",
    "h3-js": "^4.5.0",
    "jose": "^6.2.12",
    "kysely": "^0.28.17",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4"
  }
}
