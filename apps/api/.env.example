# Copy to apps/api/.env for local development. Never commit the real .env.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://helpin:helpin@localhost:5432/helpin
PUBLIC_API_URL=http://localhost:8787
WEB_URL=http://localhost:5173
WEB_ORIGINS=http://localhost:5173,http://localhost:4173

# At least 32 random characters in production: `openssl rand -base64 48`
JWT_SECRET=dev-only-secret-change-me-dev-only-secret

# Development only: this code works for every sign-in. Refused when NODE_ENV=production.
AUTH_DEV_CODE=123456

# console = codes are printed in the API log (dev). Production needs twilio + smtp.
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
EMAIL_PROVIDER=console
# Brevo (docs/07-email-and-storage.md): EMAIL_PROVIDER=smtp and these four.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# The "Login" from Brevo → SMTP & API → SMTP, and an SMTP key (not your Brevo password):
# SMTP_USER=xxxxxxxxx@smtp-brevo.com
# SMTP_PASS=xsmtpsib-...
# Or any other relay as one URL instead: SMTP_URL=smtps://user:pass@smtp.example.com:465
# Must be a sender or domain you verified in Brevo.
EMAIL_FROM=HelpIn <hello@helpin.local>

# local = files under STORAGE_DIR, served through signed /v1/storage links. s3 = any S3-compatible bucket in the EU.
STORAGE_DRIVER=local
STORAGE_DIR=./.data/storage
# Cloudflare R2 (docs/07-email-and-storage.md): STORAGE_DRIVER=s3 and these five.
# For a bucket created with the EU jurisdiction; drop ".eu" for a normal bucket.
# S3_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=helpin-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Web Push. Generate once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@helpin.local

# Emails that become admins when they sign in (ADR-023). Keep real addresses out of the repo.
ADMIN_EMAILS=

# Optional place names for areas (L-09): none | nominatim
GEOCODER=none
