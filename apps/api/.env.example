# Copy to apps/api/.env for local development. Never commit the real .env.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://helpin:helpin@localhost:5432/helpin
PUBLIC_API_URL=http://localhost:8787
WEB_URL=http://localhost:5173
WEB_ORIGINS=http://localhost:5173,http://localhost:4173

# At least 32 random characters in production: `openssl rand -base64 48`
JWT_SECRET=dev-only-secret-change-me-dev-only-secret

# Development only: this code works for every sign-in. Refused when NODE_ENV=production.
AUTH_DEV_CODE=123456

# console = codes are printed in the API log (dev). Production needs twilio + smtp.
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
EMAIL_PROVIDER=console
# SMTP_URL=smtps://user:pass@smtp.example.com:465
EMAIL_FROM=HelpIn <hello@helpin.local>

# local = files under STORAGE_DIR, served through signed /v1/storage links. s3 = any S3-compatible bucket in the EU.
STORAGE_DRIVER=local
STORAGE_DIR=./.data/storage
# S3_ENDPOINT=
# S3_REGION=eu-central-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Web Push. Generate once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@helpin.local

# Emails that become admins when they sign in (ADR-023). Keep real addresses out of the repo.
ADMIN_EMAILS=

# Optional place names for areas (L-09): none | nominatim
GEOCODER=none
